# ONE RULE: internal work files go under _private/ (never the repo root).
# _private/local-only/ additionally stays out of git (see .gitignore).
_private/

# Legacy internal folders (pre-_private layout), kept where they are so old
# references still work. Also excluded from the deploy.
outputs/
emails/
reports_EN/

# Repo plumbing
.git/
.gitignore
.gitattributes
